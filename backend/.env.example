# Fill in ONE provider, save as .env (never commit it)
# -------------------------------------------------------

# --- Anthropic (Single key or multiple keys comma-separated) ---
# ANTHROPIC_API_KEY=sk-ant-key1,sk-ant-key2
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenAI or compatible (Groq, Gemini, Ollama) ---
# You can provide 1 key or multiple keys comma-separated for automatic fallback/rotation:
# OPENAI_API_KEY=gsk_key1,gsk_key2,gsk_key3
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant

# --- Security ---
# SHIELD_API_KEY=changeme
#   Set this to protect the /scan and /build endpoints with an API key.
#   Leave empty (default) to run without auth — only safe on localhost.

# --- CORS ---
# ALLOW_ORIGINS=http://localhost:8000
#   Comma-separated list of allowed origins. Defaults to localhost only.

# --- LLM cache ---
# LLM_CACHE=disabled
#   Set to "disabled" to turn off caching entirely.
# LLM_CACHE_TTL=86400
#   Cache entry lifetime in seconds. Default: 86400 (24 hours).
# LLM_CACHE_MAX=2000
#   Maximum number of cache entries before oldest are evicted. Default: 2000.
